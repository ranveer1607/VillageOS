<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">


    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical">



        <!-- Header -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="75dp"

            android:background="#2E7D32"

            android:gravity="center">


            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Manage Health Camps"

                android:textSize="22sp"

                android:textStyle="bold"

                android:textColor="#FFFFFF"/>


        </LinearLayout>




        <androidx.cardview.widget.CardView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_margin="20dp"

            app:cardCornerRadius="15dp"

            app:cardElevation="8dp">



            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="20dp">





                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="Add New Health Camp"

                    android:textSize="20sp"

                    android:textStyle="bold"

                    android:textColor="#2E7D32"/>





                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="Camp Name"

                    android:layout_marginTop="20dp"

                    android:textStyle="bold"/>


                <EditText

                    android:id="@+id/campName"

                    android:layout_width="match_parent"

                    android:layout_height="55dp"

                    android:hint="Enter Camp Name"

                    android:padding="10dp"/>





                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="Camp Date"

                    android:layout_marginTop="15dp"

                    android:textStyle="bold"/>



                <EditText

                    android:id="@+id/campDate"

                    android:layout_width="match_parent"

                    android:layout_height="55dp"

                    android:hint="Enter Date"

                    android:padding="10dp"/>





                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="Camp Location"

                    android:layout_marginTop="15dp"

                    android:textStyle="bold"/>



                <EditText

                    android:id="@+id/campLocation"

                    android:layout_width="match_parent"

                    android:layout_height="55dp"

                    android:hint="Enter Location"

                    android:padding="10dp"/>





                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="Description"

                    android:layout_marginTop="15dp"

                    android:textStyle="bold"/>



                <EditText

                    android:id="@+id/campDescription"

                    android:layout_width="match_parent"

                    android:layout_height="100dp"

                    android:gravity="top"

                    android:hint="Enter Camp Description"

                    android:padding="10dp"/>






                <Button

                    android:id="@+id/btnPublish"

                    android:layout_width="match_parent"

                    android:layout_height="55dp"

                    android:layout_marginTop="25dp"

                    android:text="Publish Health Camp"

                    android:textSize="16sp"

                    android:textColor="#FFFFFF"

                    android:backgroundTint="#2E7D32"/>



            </LinearLayout>


        </androidx.cardview.widget.CardView>



    </LinearLayout>


</ScrollView>