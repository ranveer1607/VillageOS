<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#0D47A1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/e4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Post Matric Scholarship"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Financial Support for Higher Education"
                    android:textColor="#E3F2FD"
                    android:textSize="15sp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Information -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Information"
                    android:textColor="#0D47A1"
                    android:textStyle="bold"
                    android:textSize="20sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="🏛️ Sponsored By : Central/State Government

🎓 Scheme : Post Matric Scholarship

👨‍🎓 Beneficiaries : Students studying after Class 10

💻 Apply Mode : Online

🇮🇳 Country : India"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- About Scheme -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About Scheme"
                    android:textColor="#0D47A1"
                    android:textStyle="bold"
                    android:textSize="20sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="The Post Matric Scholarship provides financial assistance to eligible students studying in Class 11, Class 12, Diploma, ITI, Undergraduate, Postgraduate and other higher education courses. The scheme helps students continue their education by supporting tuition fees, examination fees and maintenance expenses, depending on the applicable scheme."
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
        <!-- ================= Eligibility ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eligibility"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#0D47A1"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="✔ Indian Citizen

✔ Passed Class 10 (SSC) or equivalent

✔ Studying in Class 11, 12, Diploma, ITI, UG, PG or other recognized post-matric courses

✔ Studying in a recognized school, college or university

✔ Must satisfy the category and income criteria of the applicable scholarship scheme"
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <!-- ================= Benefits ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Benefits"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#F57C00"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="🎓 Financial Assistance for Higher Education

💰 Tuition Fee Reimbursement (as per scheme rules)

📚 Maintenance Allowance

📝 Support for Examination and Academic Expenses

🏫 Encourages Students to Continue Education after Class 10"
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <!-- ================= Required Documents ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Required Documents"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#1565C0"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="📄 Aadhaar Card

📄 Passport Size Photograph

📄 Previous Year Marksheet

📄 Income Certificate

📄 Caste Certificate (if applicable)

📄 Bonafide / Admission Certificate

📄 Bank Passbook

📄 Fee Receipt (if required)"
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
        <!-- ================= How to Apply ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How to Apply"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#8E24AA"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="1️⃣ Visit the official Scholarship Portal.

2️⃣ Register as a new student.

3️⃣ Login to your account.

4️⃣ Select the Post Matric Scholarship scheme.

5️⃣ Fill in the application form carefully.

6️⃣ Upload all required documents.

7️⃣ Verify the details and submit the application.

8️⃣ Track your application status online."
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <!-- ================= Important Points ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Important Points"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#D84315"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="✔ Apply before the last date.

✔ Keep original documents ready.

✔ Bank account should be active.

✔ Aadhaar should be linked with the bank account.

✔ Check application status regularly."
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <!-- ================= Visit Official Website ================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#0D47A1"
            android:text="Visit Official Website"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:cornerRadius="18dp"/>



        <Space
            android:layout_width="match_parent"
            android:layout_height="25dp"/>

    </LinearLayout>

</ScrollView>