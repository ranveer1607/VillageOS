<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0B8F3C"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Scholarship Schemes"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Empowering students, building the future"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- Main Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Top -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@drawable/s1"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="National Scholarship"
                            android:textStyle="bold"
                            android:textSize="28sp"
                            android:textColor="#0B8F3C"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Central Government Scheme"
                            android:textColor="#1565F9"
                            android:textSize="15sp"
                            android:layout_marginTop="6dp"/>

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Financial assistance for eligible students to support their education and bright future."
                    android:textSize="18sp"
                    android:textColor="#333333"
                    android:layout_marginTop="18dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDDDDD"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"/>

                <!-- Eligibility -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eligibility"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:textColor="#1565F9"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Indian citizen&#10;• Family income below limit&#10;• Required academic percentage"
                    android:textSize="18sp"
                    android:textColor="#333333"
                    android:layout_marginTop="8dp"/>

                <!-- Documents -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Required Documents"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:textColor="#16A34A"
                    android:layout_marginTop="20dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Aadhaar Card&#10;• Income Certificate&#10;• Marksheet&#10;• Bank Passbook"
                    android:textSize="18sp"
                    android:textColor="#333333"
                    android:layout_marginTop="8dp"/>

                <!-- Benefits -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Benefits"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:textColor="#7C3AED"
                    android:layout_marginTop="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹10,000 - ₹50,000 per year"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1E3A8A"/>

                <!-- Application -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Application Period"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:textColor="#F97316"
                    android:layout_marginTop="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 Jun 2024 - 31 Aug 2024"
                    android:textSize="18sp"/>

                <!-- About -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About the Scheme"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:textColor="#B45309"
                    android:layout_marginTop="20dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="This scheme aims to provide financial support to meritorious students from economically weaker sections to help them continue their education without financial stress."
                    android:textSize="17sp"
                    android:textColor="#333333"
                    android:layout_marginTop="8dp"/>
                <Button
                    android:id="@+id/btn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:text=" https://scholarships.gov.in/"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#1565F9"/>
                <!-- Apply Button -->
                <Button
                    android:id="@+id/btnApply"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:text="Apply Now"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1565F9"/>

                <!-- Website Button -->


            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>