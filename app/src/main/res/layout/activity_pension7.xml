<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8F4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">

        <!-- Banner -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="275dp"
            android:scaleType="centerCrop"
            android:src="@drawable/p7" />

        <!-- Title -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Atal Pension Yojana (APY)"
            android:textStyle="bold"
            android:textSize="24sp"
            android:textColor="#1B5E20"
            android:gravity="center"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="अटल पेंशन योजना"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#555555"
            android:gravity="center"
            android:layout_marginBottom="15dp"/>

        <!-- About -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About Scheme"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#2E7D32"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Atal Pension Yojana (APY) is a Government of India pension scheme administered by the Pension Fund Regulatory and Development Authority (PFRDA). It aims to provide financial security during old age, especially for workers in the unorganized sector. Subscribers receive a guaranteed monthly pension after attaining 60 years of age based on their chosen contribution plan."
            android:textSize="16sp"
            android:textColor="#444444"/>

        <!-- Quick Information -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quick Information"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#2E7D32"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Department : Ministry of Finance"
                android:textStyle="bold"
                android:textSize="17sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Regulator : Pension Fund Regulatory and Development Authority (PFRDA)"
                android:textStyle="bold"
                android:textSize="17sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Eligibility Age : 18–40 Years"
                android:textStyle="bold"
                android:textSize="17sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contribution Period : Minimum 20 Years"
                android:textStyle="bold"
                android:textSize="17sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guaranteed Pension : ₹1,000 to ₹5,000 Per Month After 60 Years"
                android:textStyle="bold"
                android:textSize="17sp"/>

        </LinearLayout>
        <!-- Benefits -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Benefits"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#2E7D32"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✔ Guaranteed monthly pension of ₹1,000, ₹2,000, ₹3,000, ₹4,000 or ₹5,000 after attaining 60 years of age."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✔ Provides financial security during old age."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✔ After the subscriber's death, the spouse receives the same pension."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✔ After the death of both subscriber and spouse, the accumulated pension corpus is returned to the nominee."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✔ Monthly contributions are automatically debited from the subscriber's bank account."
                android:textSize="16sp"
                android:padding="5dp"/>

        </LinearLayout>


        <!-- Eligibility -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eligibility"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#2E7D32"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Applicant must be an Indian citizen."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Age should be between 18 and 40 years at the time of enrolment."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Applicant must have a savings bank account or post office savings account."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Aadhaar number and a registered mobile number are recommended for easy account management."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• The subscriber must contribute regularly until attaining 60 years of age."
                android:textSize="16sp"
                android:padding="5dp"/>

        </LinearLayout>


        <!-- Required Documents -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Required Documents"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#2E7D32"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📄 Aadhaar Card"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏦 Savings Bank Passbook / Post Office Passbook"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📱 Registered Mobile Number"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📷 Passport-size Photograph"
                android:textSize="16sp"
                android:padding="5dp"/>
        </LinearLayout>
        <!-- Who is Not Eligible -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Who is Not Eligible"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#D32F2F"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Persons below 18 years or above 40 years of age."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Persons without a savings bank account or post office savings account."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Individuals unwilling to contribute regularly until 60 years of age."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Applicants providing incorrect or incomplete information during enrolment."
                android:textSize="16sp"
                android:padding="5dp"/>

        </LinearLayout>


        <!-- Pension Details -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pension Details"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#2E7D32"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Subscribers can choose a guaranteed monthly pension of ₹1,000, ₹2,000, ₹3,000, ₹4,000 or ₹5,000."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Monthly contribution depends on the subscriber's age and selected pension amount."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Contributions continue until the subscriber reaches 60 years of age."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Pension is paid monthly after attaining 60 years of age."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• After the subscriber's death, the spouse receives the same pension. After both the subscriber and spouse pass away, the accumulated corpus is paid to the nominee."
                android:textSize="16sp"
                android:padding="5dp"/>

        </LinearLayout>


        <!-- How to Apply -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How to Apply"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#2E7D32"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Visit your bank or post office where you have a savings account."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Request and fill out the Atal Pension Yojana (APY) enrolment form."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Submit your Aadhaar number, mobile number and nominee details."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Select the desired pension amount and authorize auto-debit from your savings account."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. After successful registration, monthly contributions will be automatically deducted until you attain 60 years of age."
                android:textSize="16sp"
                android:padding="5dp"/>

        </LinearLayout>
        <!-- Helpline -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Helpline"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#2E7D32"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="For assistance, contact your nearest Bank Branch or Post Office."
                android:textStyle="bold"
                android:textSize="16sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PFRDA Toll Free: 1800-110-069"
                android:textSize="16sp"
                android:paddingTop="8dp"/>

        </LinearLayout>


        <!-- Official Website -->


        <!-- Apply Now Button -->

        <Button
            android:id="@+id/btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apply Now"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#43A047"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>