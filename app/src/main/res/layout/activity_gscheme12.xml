<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0B8F3C"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="PM-USP Central Sector Scheme"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Scholarship for meritorious students pursuing higher education"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

        </LinearLayout>

        <!-- Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PM-USP Central Sector Scheme of Scholarship"
                    android:textColor="#0B8F3C"
                    android:textStyle="bold"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Ministry of Education, Government of India"
                    android:textColor="#1565F9"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="This scholarship supports meritorious students from economically weaker families to pursue higher education in recognized colleges and universities."
                    android:textColor="#333333"
                    android:textSize="17sp" />

                <!-- Eligibility -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Eligibility"
                    android:textColor="#1565F9"
                    android:textStyle="bold"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Indian Citizen&#10;• Passed Class 12 from a recognized board&#10;• Enrolled in a regular UG/PG course&#10;• Family income should satisfy government guidelines&#10;• Must meet academic criteria"
                    android:textSize="16sp" />

                <!-- Documents -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Required Documents"
                    android:textColor="#16A34A"
                    android:textStyle="bold"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Aadhaar Card&#10;• Class 12 Marksheet&#10;• Income Certificate&#10;• Admission Proof&#10;• Bank Passbook&#10;• Passport-size Photo"
                    android:textSize="16sp" />

                <!-- Benefits -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Benefits"
                    android:textColor="#7C3AED"
                    android:textStyle="bold"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Financial assistance for higher education&#10;• Scholarship credited directly to bank account&#10;• Supports continuation of studies"
                    android:textSize="16sp" />

                <!-- About -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="About the Scheme"
                    android:textColor="#F97316"
                    android:textStyle="bold"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="The PM-USP Central Sector Scheme of Scholarship encourages talented students to continue higher education by providing financial support based on merit and eligibility criteria."
                    android:textSize="16sp" />

                <!-- Website -->
                <Button
                    android:id="@+id/btn"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#FFFFFF"
                    android:text="https://www.myscheme.gov.in/schemes/csss-cus"
                    android:textAllCaps="false"
                    android:textColor="#1565F9"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <!-- Apply Button -->
                <Button
                    android:id="@+id/btnApply"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:text="Apply Now"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1565F9"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>