<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">

        <!-- Banner Image -->

        <ImageView
            android:layout_width="316dp"
            android:layout_height="306dp"
            android:layout_marginLeft="30dp"
            android:scaleType="centerCrop"
            android:src="@drawable/f7" />

        <!-- Title -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agriculture Infrastructure Fund (AIF)"
            android:textStyle="bold"
            android:textSize="26sp"
            android:textColor="#2E7D32"
            android:gravity="center"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Financing Facility for Agriculture Infrastructure Projects"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#000000"
            android:layout_marginBottom="15dp"/>

        <!-- About -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About Agriculture Infrastructure Fund"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#1B5E20"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The Agriculture Infrastructure Fund (AIF) is a Central Sector Financing Scheme launched by the Government of India on 9 August 2020. It provides medium and long-term debt financing for creating post-harvest management infrastructure and community farming assets. The scheme supports projects such as warehouses, cold storage units, grading and sorting facilities, primary processing centres, silos and other agriculture infrastructure to improve farmers' income and reduce post-harvest losses."
            android:textSize="16sp"
            android:textColor="#444444"
            android:layout_marginTop="8dp"/>

        <!-- Quick Information -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quick Information"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#1B5E20"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scheme Type : Central Sector Financing Scheme"
                android:textStyle="bold"
                android:textSize="17sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Launch Date : 9 August 2020"
                android:textStyle="bold"
                android:textSize="17sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ministry : Ministry of Agriculture and Farmers Welfare"
                android:textStyle="bold"
                android:textSize="17sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Purpose : Financing Agriculture Infrastructure"
                android:textStyle="bold"
                android:textSize="17sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Support : Interest Subvention and Credit Guarantee"
                android:textStyle="bold"
                android:textSize="17sp"/>

        </LinearLayout>
        <!-- Objectives -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Objectives"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#1B5E20"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Develop modern post-harvest management infrastructure."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Reduce post-harvest losses and improve the quality of agricultural produce."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Increase farmers' income by improving storage and marketing facilities."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Promote investment in agriculture infrastructure across India."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Strengthen the agricultural supply chain."
                android:textSize="16sp"
                android:padding="5dp"/>

        </LinearLayout>


        <!-- Benefits -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Benefits"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#1B5E20"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✔ Interest subvention of 3% per annum on eligible loans (subject to scheme guidelines)."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✔ Credit guarantee support for eligible borrowers through CGTMSE."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✔ Financial assistance for warehouses, cold storage and processing units."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✔ Better storage facilities reduce crop wastage."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✔ Improves market access and value addition for farmers."
                android:textSize="16sp"
                android:padding="5dp"/>

        </LinearLayout>


        <!-- Eligibility -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eligibility"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#1B5E20"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Individual farmers are eligible."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Farmer Producer Organizations (FPOs) can apply."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Primary Agricultural Credit Societies (PACS) are eligible."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Agricultural entrepreneurs, startups and agri-business companies can apply."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Self Help Groups (SHGs), Joint Liability Groups (JLGs) and cooperative societies are also eligible."
                android:textSize="16sp"
                android:padding="5dp"/>

        </LinearLayout>
        <!-- Who Can Apply -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Who Can Apply"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#1B5E20"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Individual Farmers"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Farmer Producer Organizations (FPOs)"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Primary Agricultural Credit Societies (PACS)"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Agricultural Entrepreneurs"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Agri-Startups"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Self Help Groups (SHGs)"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Cooperative Societies"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Agri-Business Companies"
                android:textSize="16sp"
                android:padding="5dp"/>

        </LinearLayout>


        <!-- Eligible Projects -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eligible Projects"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#1B5E20"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏢 Warehouses"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="❄ Cold Storage Units"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌾 Silos"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚙ Primary Processing Centres"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📦 Collection Centres"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📊 Grading and Sorting Units"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚚 Supply Chain Infrastructure"
                android:textSize="16sp"
                android:padding="5dp"/>

        </LinearLayout>


        <!-- Required Documents -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Required Documents"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#1B5E20"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📄 Aadhaar Card"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏦 Bank Account Details"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🪪 Identity Proof"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📋 Project Report / Business Plan"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📱 Registered Mobile Number"
                android:textSize="16sp"
                android:padding="5dp"/>

        </LinearLayout>


        <!-- Financial Assistance -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Financial Assistance"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#1B5E20"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• 3% annual interest subvention on eligible loans up to ₹2 crore."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Interest subvention is available for a maximum period of 7 years, subject to scheme guidelines."
                android:textSize="16sp"
                android:padding="5dp"/>

        </LinearLayout>
        <!-- Interest Subvention -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Interest Subvention"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#1B5E20"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The Agriculture Infrastructure Fund provides an interest subvention of 3% per annum on eligible loans up to ₹2 crore. This benefit is available for a maximum period of 7 years, subject to the scheme guidelines issued by the Government of India."
                android:textSize="16sp"
                android:padding="5dp"/>

        </LinearLayout>


        <!-- Credit Guarantee -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Credit Guarantee"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#1B5E20"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Eligible borrowers may receive credit guarantee coverage through the Credit Guarantee Fund Trust for Micro and Small Enterprises (CGTMSE) or other applicable guarantee mechanisms as per the scheme guidelines."
                android:textSize="16sp"
                android:padding="5dp"/>

        </LinearLayout>


        <!-- How to Apply -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How to Apply"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#1B5E20"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Visit the official Agriculture Infrastructure Fund portal."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Register as a new applicant."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Complete the online application and upload the required documents."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Submit your project proposal for evaluation."
                android:textSize="16sp"
                android:padding="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. After approval, complete the loan process with the selected lending institution."
                android:textSize="16sp"
                android:padding="5dp"/>

        </LinearLayout>


        <!-- Helpline -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Helpline"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#1B5E20"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Agriculture Infrastructure Fund Helpdesk"
                android:textStyle="bold"
                android:textSize="18sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="☎ 011-23381092"
                android:textSize="16sp"
                android:paddingTop="8dp"/>

        </LinearLayout>


        <!-- Official Website -->


        <!-- Apply Button -->

        <Button
            android:id="@+id/btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apply Now"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#43A047"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

</ScrollView>