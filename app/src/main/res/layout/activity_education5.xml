<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#2E7D32">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="147dp"
                    android:layout_height="119dp"
                    android:src="@drawable/cycle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Free Bicycle Scheme"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="24sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Support for Rural School Students"
                    android:textColor="#E8F5E9"
                    android:textSize="15sp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <!-- Quick Information -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Information"
                    android:textColor="#1B5E20"
                    android:textStyle="bold"
                    android:textSize="20sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#555555"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp"
                    android:text="🏛️ State : Maharashtra

🚲 Scheme : Free Bicycle Scheme

👧 Beneficiaries : Eligible Rural Students (as per local authority rules)

🏫 Class : Generally 5th–12th

💻 Apply Mode : Through School / Zilla Parishad"/>
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <!-- About Scheme -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About Scheme"
                    android:textColor="#1B5E20"
                    android:textStyle="bold"
                    android:textSize="20sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#555555"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp"
                    android:text="The Free Bicycle Scheme helps eligible rural students who travel long distances to school. The scheme aims to reduce school dropout rates, improve attendance, and make education more accessible. Availability and eligibility may vary by district or local authority."
                    />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
        <!-- ================= Eligibility ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eligibility"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#1B5E20"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="✔ Student should be a resident of Maharashtra

✔ Girl student studying in Class 5 to Class 12

✔ Student should study in a Government or Government-Aided School

✔ Distance from home to school should generally be at least 1–2 km (as per local authority rules)

✔ Preference may be given to students from rural and economically weaker families"
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <!-- ================= Benefits ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Benefits"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#1B5E20"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="🚲 Bicycle provided at subsidized cost

💰 Up to 90% subsidy (where applicable)

🏫 Easier travel to school

📚 Improves school attendance

🎓 Helps reduce school dropout among rural students"
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <!-- ================= Required Documents ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Required Documents"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#1B5E20"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="📄 Aadhaar Card

📄 School Bonafide Certificate

📄 Income Certificate

📄 Residence Certificate

📄 Bank Passbook

📄 Passport Size Photograph

📄 Distance Certificate (if required)

📄 BPL Certificate (if applicable)"
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
        <!-- ================= How to Apply ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How to Apply"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#1B5E20"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="1️⃣ Contact your School Headmaster or Principal.

2️⃣ Collect the application form from the School, Panchayat Samiti or Zilla Parishad Office.

3️⃣ Fill in all required details.

4️⃣ Attach all required documents.

5️⃣ Submit the application to the concerned authority.

6️⃣ Eligible students are selected as per Government / Zilla Parishad rules.

7️⃣ Approved beneficiaries receive the bicycle or subsidy."
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <!-- ================= Important Points ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Important Points"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#1B5E20"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="✔ Scheme availability may differ from district to district.

✔ Apply before the last date announced by the Zilla Parishad.

✔ Keep original documents ready for verification.

✔ Students should regularly attend school.

✔ Contact your School or Zilla Parishad Office for the latest updates."
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <!-- ================= Official Website Button ================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#2E7D32"
            android:text="Visit Zilla Parishad Schemes"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="17sp"
            app:cornerRadius="18dp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp"/>

    </LinearLayout>

</ScrollView>