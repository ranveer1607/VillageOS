<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:cardBackgroundColor="#2E7D32"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/e10" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Rajarshi Chhatrapati Shahu Maharaj Scholarship"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tuition Fee and Exam Fee Reimbursement"
                    android:textColor="#E8F5E9"
                    android:textSize="15sp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Information -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Information"
                    android:textColor="#1B5E20"
                    android:textStyle="bold"
                    android:textSize="20sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="🏛️ State : Maharashtra

🎓 Scheme : Rajarshi Chhatrapati Shahu Maharaj Scholarship

👨‍🎓 Beneficiaries : Eligible Open / EWS Students

💰 Benefit : Tuition Fee and Exam Fee Reimbursement

💻 Apply Mode : MahaDBT Online"
                    android:textColor="#555555"
                    android:textSize="15sp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- About Scheme -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About Scheme"
                    android:textColor="#1B5E20"
                    android:textStyle="bold"
                    android:textSize="20sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="The Rajarshi Chhatrapati Shahu Maharaj Scholarship is a Maharashtra Government scheme that provides tuition fee and examination fee reimbursement to eligible students pursuing higher and professional education. The scheme aims to reduce the financial burden on students from economically weaker families."
                    android:textColor="#555555"
                    android:textSize="15sp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
        <!-- ================= Eligibility ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eligibility"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#1B5E20"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="✔ Student must be a domicile of Maharashtra

✔ Family annual income should not exceed ₹8,00,000

✔ Student must have taken admission in a recognized institution

✔ Applicable for eligible Higher and Technical Education courses

✔ Admission should be through the prescribed admission process (CAP where applicable)"
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <!-- ================= Benefits ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Benefits"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#1B5E20"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="🎓 Tuition Fee Reimbursement

📝 Examination Fee Reimbursement

👩 Female students may receive up to 100% reimbursement in eligible professional courses

👨 Eligible male students receive reimbursement as per Government rules

💰 Financial support through Direct Benefit Transfer (DBT)"
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <!-- ================= Required Documents ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Required Documents"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#1B5E20"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="📄 Aadhaar Card

📄 Domicile Certificate

📄 Income Certificate

📄 Previous Year Marksheet

📄 Admission Receipt

📄 CAP Allotment Letter (if applicable)

📄 Bonafide Certificate

📄 Bank Passbook

📄 Passport Size Photograph"
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
        <!-- ================= How to Apply ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How to Apply"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#1B5E20"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="1️⃣ Visit the MahaDBT Portal.

2️⃣ Register using Aadhaar and create your profile.

3️⃣ Login to your account.

4️⃣ Select 'Rajarshi Chhatrapati Shahu Maharaj Scholarship'.

5️⃣ Fill in the application form.

6️⃣ Upload all required documents.

7️⃣ Verify your details carefully.

8️⃣ Submit the application and save the Application ID."
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <!-- ================= Important Points ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Important Points"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#1B5E20"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="✔ Apply before the last date.

✔ Aadhaar must be linked with your bank account.

✔ Upload clear scanned documents.

✔ Keep your Application ID safe.

✔ Check your application status regularly on MahaDBT."
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <!-- ================= Official Website Button ================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#2E7D32"
            android:text="Visit MahaDBT Portal"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            app:cornerRadius="18dp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp"/>

    </LinearLayout>

</ScrollView>