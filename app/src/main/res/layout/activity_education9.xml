<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:cardBackgroundColor="#2E7D32"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="355dp"
                    android:layout_height="90dp"
                    android:src="@drawable/e9" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="EBC Scholarship"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Economically Backward Class Scholarship"
                    android:textColor="#E8F5E9"
                    android:textSize="15sp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <!-- Quick Information -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Information"
                    android:textColor="#1B5E20"
                    android:textStyle="bold"
                    android:textSize="20sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="🏛️ State : Maharashtra

🎓 Scheme : EBC Scholarship

👨‍🎓 Beneficiaries : Economically Backward Class (Open Category) Students

🏫 Education : Higher and Technical Education

💻 Apply Mode : MahaDBT Online"
                    android:textColor="#555555"
                    android:textSize="15sp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <!-- About Scheme -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About Scheme"
                    android:textColor="#1B5E20"
                    android:textStyle="bold"
                    android:textSize="20sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="The EBC Scholarship provides financial assistance to eligible Economically Backward Class (Open Category) students of Maharashtra pursuing higher or technical education. The scheme helps reduce the financial burden by supporting tuition fees and other educational expenses as per Government rules."
                    android:textColor="#555555"
                    android:textSize="15sp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
        <!-- ================= Eligibility ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eligibility"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#1B5E20"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="✔ Student must be a resident of Maharashtra

✔ Student should belong to the Open (Economically Backward Class) Category

✔ Family annual income should not exceed ₹8,00,000

✔ Student should be studying in a recognized college or university

✔ Admission should be through the prescribed admission process"
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <!-- ================= Benefits ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Benefits"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#1B5E20"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="🎓 Tuition Fee Reimbursement

💰 Examination Fee Reimbursement

📚 Financial Assistance for Higher Education

🏫 Supports Professional and Technical Courses

🎯 Reduces the Financial Burden on Students"
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <!-- ================= Required Documents ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Required Documents"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#1B5E20"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="📄 Aadhaar Card

📄 Income Certificate

📄 Domicile Certificate

📄 Previous Year Marksheet

📄 Admission Receipt

📄 Bonafide Certificate

📄 Bank Passbook

📄 Passport Size Photograph"
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
        <!-- ================= How to Apply ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How to Apply"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#1B5E20"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="1️⃣ Visit the MahaDBT Portal.

2️⃣ Register and create your profile.

3️⃣ Login using your username and password.

4️⃣ Select 'Rajarshi Chhatrapati Shahu Maharaj Shikshan Shulkh Shishyavrutti Yojna (EBC)'.

5️⃣ Fill in the application form.

6️⃣ Upload all required documents.

7️⃣ Verify your details and submit the application.

8️⃣ Track your application status online."
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <!-- ================= Important Points ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Important Points"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#1B5E20"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="✔ Apply before the last date.

✔ Upload clear scanned documents.

✔ Bank account should be linked with Aadhaar.

✔ Keep your Application ID safe.

✔ Check your application status regularly on MahaDBT."
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <!-- ================= Official Website Button ================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#2E7D32"
            android:text="Visit MahaDBT Portal"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            app:cornerRadius="18dp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="25dp"/>

    </LinearLayout>

</ScrollView>