<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:cardCornerRadius="25dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#1565C0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="140dp"
                    android:layout_height="116dp"
                    android:src="@drawable/n1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="National Scholarship Portal"
                    android:textStyle="bold"
                    android:textSize="24sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="One Platform for Government Scholarships"
                    android:textSize="15sp"
                    android:textColor="#E3F2FD"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- About -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About Scheme"
                    android:textStyle="bold"
                    android:textSize="19sp"
                    android:textColor="#1565C0"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="The National Scholarship Portal (NSP) is a Government of India digital platform that allows students to apply for Central Government, State Government, UGC and AICTE scholarship schemes through a single online portal. Students can register, apply online, track their application status and receive eligible scholarship amounts through Direct Benefit Transfer (DBT)."
                    android:textColor="#555555"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Eligibility Card -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/verified" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Eligibility"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="#2E7D32"/>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="• Indian Citizen&#10;&#10;• Student studying in a recognized School, College or University&#10;&#10;• Must satisfy the eligibility of the selected scholarship&#10;&#10;• Aadhaar/OTR registration (if required)&#10;&#10;• Valid Bank Account linked with Aadhaar&#10;&#10;• Income and category criteria depend on the selected scholarship."
                    android:textSize="15sp"
                    android:textColor="#555555"
                    android:lineSpacingExtra="5dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Benefits Card -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Benefits"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="#F57F17"/>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="• Apply for multiple Central and State Government scholarships&#10;&#10;• Easy online application process&#10;&#10;• Direct Benefit Transfer (DBT) to bank account&#10;&#10;• Real-time application status tracking&#10;&#10;• Transparent verification process&#10;&#10;• Single portal for multiple scholarship schemes."
                    android:textSize="15sp"
                    android:textColor="#555555"
                    android:lineSpacingExtra="5dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
        <!-- Required Documents Card -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                       />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Required Documents"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="#1976D2"/>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="5dp"
                    android:text="• Aadhaar Card (or OTR details if applicable)

• Passport Size Photograph

• Previous Year Marksheet

• Income Certificate

• Caste Certificate (if applicable)

• Bonafide/Admission Certificate

• Bank Passbook (Student's Account)

• Fee Receipt (if required by the selected scheme)"
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- How to Apply Card -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="How to Apply"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="#8E24AA"/>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="5dp"
                    android:text="1. Register on the National Scholarship Portal

2. Complete One-Time Registration (OTR), if required

3. Log in to your account

4. Select the eligible scholarship

5. Fill in the application form

6. Upload the required documents

7. Submit the application

8. Track your application status online"
                    android:textSize="15sp"
                    android:textColor="#555555"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
        <!-- Help & Support Card -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Help and Support"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#1565C0"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="If you face any issue while applying, visit the official National Scholarship Portal. You can check scholarship eligibility, application status, and latest notifications."
                    android:textSize="15sp"
                    android:textColor="#555555"
                    android:lineSpacingExtra="5dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Official Website Button -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="🌐 Visit Official Website"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            app:cornerRadius="16dp"
            android:backgroundTint="#1565C0"
            android:textColor="@android:color/white"/>

        <!-- Bottom Space -->

        <Space
            android:layout_width="match_parent"
            android:layout_height="25dp"/>

    </LinearLayout>

</ScrollView>